{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "allowJs": false,
    "outDir": "./electron/runtime",
    "rootDir": ".",
    "removeComments": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "electron/src/**/*.cts",
    "src/shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "electron/runtime",
    "desktop",
    "desktopsrc"
  ]
}
